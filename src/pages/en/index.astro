---
/**
 * /en/ — the English home. Same thesis, same facts, same drawn court.
 * Intent in visible prose: "basketball club Douala".
 */
import Base from '../../layouts/Base.astro';
import HeroAccueil from '../../components/HeroAccueil.astro';
import { SITE, FAITS, PARCOURS, TERRAIN_3X3, PROTECTION_EN } from '../../data/site';
import { NB_OUVERTS, SECTEURS, VACANCE_A_JOUR_LE, GRILLE_APPROUVEE, fcfa } from '../../data/offre';
import { EN, PROMESSES_EN, OFFRE_EN, MENTION_GRILLE_EN } from '../../data/en';

const dateEN = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(VACANCE_A_JOUR_LE + 'T00:00:00Z'));
const faits = [
  { valeur: `${FAITS.ageMin} → ${FAITS.ageMax}`, note: 'the age you enter, and the age you leave for something higher' },
  { valeur: 'Girls and boys', note: 'the programme is built for both, with no reserved category' },
  { valeur: `${FAITS.categories.length} categories`, note: FAITS.categories.join(' · ') },
  { valeur: `${FAITS.nombreNiveaux} levels`, note: 'from Discover to Progress, and you always know where you stand' }
];
const faq = [
  { q: 'What is The Upgrade Lab?', a: `A youth basketball development programme in Douala for ages ${FAITS.ageMin} to ${FAITS.ageMax}, girls and boys, organised in five levels — Discover, Develop, Compete, Perform, Progress — from first contact with the ball to higher clubs, academies and scholarships.` },
  { q: 'What court does the programme train on?', a: EN.terrain },
  { q: 'How can a company support the programme?', a: 'Through an annual partnership in one of eight business sectors offered in Douala, or by sponsoring a single athlete for a full season. Deliverables are written tier by tier on the Sponsors page.' }
];
---

<Base titre="The Upgrade Lab — youth basketball in Douala" titreBrut description={SITE.descriptionEN} lang="en" faq={faq}>

  <HeroAccueil lang="en" />

  <section class="section sur-bloc" aria-labelledby="t-vac">
    <div class="conteneur">
      <p class="balise"><span class="chev" aria-hidden="true"></span>To companies</p>
      <h2 id="t-vac">{NB_OUVERTS === SECTEURS.length ? <><span class="obl">Every sector</span> is still up for grabs</> : <><span class="obl">{NB_OUVERTS} of {SECTEURS.length} sectors</span> still up for grabs</>}</h2>
      <p class="chapo mesure">A sector partnership is exclusive for the season. The table says what is free, and it never lies in the convenient direction: no sector is declared taken to manufacture scarcity.</p>
      <ul class="secteurs" role="list">{SECTEURS.map((s) => <li class={`secteur secteur--${s.statut}`}><span class="secteur__nom">{s.nomEn}</span><span class="secteur__etat">{s.statut === 'ouvert' ? 'open' : 'taken'}</span></li>)}</ul>
      <div class="rangee entre bout" style="--gap:1.25rem">
        <p class="petit t-sourd">Availability checked on <time datetime={VACANCE_A_JOUR_LE}>{dateEN}</time>. A sector switches to “taken” on the day of a signature, never before.</p>
        <a class="bouton primaire" href="/en/sponsors/">Tiers and deliverables <span class="chev" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       LES PALIERS. What a company receives, five cards, before anything else.
       ================================================================= -->
  <section class="section" aria-labelledby="t-paliers">
    <div class="conteneur">
      <p class="balise"><span class="chev" aria-hidden="true"></span>What you receive</p>
      <h2 id="t-paliers"><span class="obl">Four tiers,</span> and the sponsorship of one athlete</h2>
      {!GRILLE_APPROUVEE && <p class="mesure t-sourd paliers-accueil__note"><b class="t-ambre">{MENTION_GRILLE_EN.etiquette}.</b> {MENTION_GRILLE_EN.texte}</p>}
      <ol class="paliers-accueil" role="list">
        {OFFRE_EN.map((o) => (
          <li style={`--f:${o.fill};--s:${o.surFill}`}>
            <a href={o.href}>
              <span class="chevs" aria-hidden="true">{Array.from({ length: o.chevrons }).map(() => <i class="chev"></i>)}</span>
              <b>{o.nom}</b>
              <span class="paliers-accueil__montant">{fcfa(o.montantFCFA)}<small> / year</small></span>
              <span class="paliers-accueil__pour">{o.pour}</span>
              <span class="paliers-accueil__lien">The tier in detail <span class="chev" aria-hidden="true"></span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="t-parcours">
    <div class="conteneur">
      <p class="balise"><span class="chev" aria-hidden="true"></span>The pathway</p>
      <h2 id="t-parcours"><span class="obl">Five levels,</span> and never any doubt about the next</h2>
      <p class="chapo mesure">A programme that writes down what it expects of a young player at each stage, and what moves them to the next. You do not move up with age: you move up on criteria you can see with the naked eye.</p>
      <ol class="niveaux" role="list">
        {PARCOURS.map((n) => (
          <li class="niveau cut" style={`--fill:${n.fill};--sur:${n.surFill};--txt:${n.texteSurNoir}`}>
            <a href={`/en${n.href}`} class="niveau__lien">
              <span class="niveau__rang" aria-hidden="true"><span class="chevs">{Array.from({ length: n.chevrons }).map(() => <i class="chev"></i>)}</span></span>
              <span class="niveau__nom">{n.label}</span>
              <span class="niveau__promesse">{PROMESSES_EN[n.key].promesse}</span>
              <span class="niveau__resume">{PROMESSES_EN[n.key].resume}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="petit t-sourd niveaux__note mesure">The six categories — {FAITS.categories.join(', ')} — say how old you are. The five levels say the state of your game. <a href="/en/le-parcours/">The pathway, level by level.</a></p>
    </div>
  </section>

  <section class="section sur-bloc" aria-labelledby="t-terrain">
    <div class="conteneur">
      <div class="grille-2" style="--gap:2.5rem">
        <div>
          <p class="balise"><span class="chev" aria-hidden="true"></span>The court</p>
          <h2 id="t-terrain">A slab, a basket, <span class="obl t-ambre">an Olympic discipline</span></h2>
          <p class="mesure">The FIBA 3x3 format is {TERRAIN_3X3.longueurM} metres by {TERRAIN_3X3.largeurM}, one basket, a regulation key, a regulation free-throw line, and the {TERRAIN_3X3.arcM} m arc as the two-point line. It has been Olympic since {TERRAIN_3X3.premiereOlympiade}. A slab in Douala carrying those lines is not half a court: it is a regulation court for an Olympic sport.</p>
          <p class="mesure">And that is not an arrangement with reality. {EN.etude} A shorter court is not a lesser court. For a child, it is a better one.</p>
        </div>
        <div class="carte-trait" style="--c:18px"><div class="dedans">
          <p class="etiquette t-ambre">What it changes for a young player</p>
          <ul class="liste-fleche" role="list">
            <li>One basket, five or six players on the area: everyone touches the ball far more often than on a full court.</li>
            <li>The lines are those of the real game — the key, the free throw, the arc — and the movement learned here is the movement expected everywhere else.</li>
            <li>3x3 has its own tour, its own World Cup and its own world ranking: it is an exit in its own right, not a holding format.</li>
          </ul>
        </div></div>
      </div>
    </div>
  </section>

  <section class="section serree" aria-labelledby="t-eng">
    <div class="conteneur">
      <div class="grille-2" style="--gap:2.5rem">
        <div>
          <p class="balise"><span class="chev" aria-hidden="true"></span>To families</p>
          <h2 id="t-eng">A basketball club in Douala that writes its commitments before being asked</h2>
          <p class="mesure">Most of the faces in this programme belong to children. That single fact imposes rules, and they hold on every page of the site — not only the one that details them.</p>
          <a class="bouton fantome" href="/en/protection-des-mineurs/">The commitments, in full <span class="chev" aria-hidden="true"></span></a>
        </div>
        <ul class="engagements" role="list">{PROTECTION_EN.map((e) => <li class="engagement"><span class="chev t-rose" aria-hidden="true"></span><span>{e}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="t-porte">
    <div class="conteneur etroit">
      <h2 id="t-porte" class="porte__titre"><span class="obl">It all starts</span> with a trial session</h2>
      <p class="chapo">For a young person aged {FAITS.ageMin} to {FAITS.ageMax} in Douala: a full session with the group of their age, honest feedback at the end, and nothing to pay or prove beforehand.</p>
      <div class="rangee" style="--gap:.75rem">
        <a class="bouton primaire" href="/en/rejoindre/">Join the programme <span class="chev" aria-hidden="true"></span></a>
        <a class="bouton fantome" href="/en/questions/">Parents’ questions</a>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (min-width:52em){.faits{grid-template-columns:repeat(4,1fr)}}
  @media (max-width:47.99em){.hero::before{display:none}.hero__titre{font-size:clamp(2.25rem,1.3rem + 4.6vw,3.25rem)}}

  .niveaux{list-style:none;margin:var(--e6) 0 0;padding:0;display:grid;gap:1px;background:var(--trait);clip-path:var(--chanfrein);--c:14px}
  @media (min-width:52em){.niveaux{grid-template-columns:repeat(5,1fr)}}
  .niveau{background:var(--bg);--c:0}
  .niveau__lien{display:grid;gap:.45em;align-content:start;padding:var(--e5) var(--e4);min-height:100%;text-decoration:none;color:var(--fg);border-top:6px solid var(--fill);transition:background .5s var(--ease)}
  .niveau__lien:hover,.niveau__lien:focus-visible{background:var(--bloc)}
  .niveau__rang .chev{width:.55em;height:.55em;color:var(--txt)}
  .niveau__nom{font-family:var(--f-titre);font-weight:900;text-transform:uppercase;font-size:var(--t-h3);line-height:1;color:var(--txt);transform:skewX(calc(-1 * var(--oblique)));display:inline-block;transform-origin:0 100%}
  .niveau__promesse{font-weight:700;line-height:1.3}.niveau__resume{font-size:var(--t-petit);line-height:1.45;color:var(--fg-dim)}
  .niveaux__note{margin-top:var(--e5)}.niveaux__note a{color:var(--t-bleu);text-decoration:underline}
  .engagements{list-style:none;margin:0;padding:0;display:grid;gap:1px;background:var(--trait);clip-path:var(--chanfrein);--c:12px;align-self:start}
  .engagement{display:flex;gap:.8em;align-items:flex-start;background:var(--bg);padding:var(--e4);font-weight:600;line-height:1.4}
  .engagement .chev{flex:none;width:.6em;height:.6em;margin-top:.35em}
  .secteurs{list-style:none;margin:var(--e6) 0 var(--e5);padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--trait);clip-path:var(--chanfrein);--c:12px}
  @media (min-width:40em){.secteurs{grid-template-columns:repeat(4,1fr)}}
  .secteur{background:var(--bg);padding:var(--e4);display:flex;justify-content:space-between;align-items:baseline;gap:.5em}
  .secteur__nom{font-family:var(--f-titre);font-weight:700;text-transform:uppercase;font-size:var(--t-h4);line-height:1}
  .secteur__etat{font-size:var(--t-micro);font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .secteur--ouvert .secteur__etat{color:var(--t-ambre)}.secteur--pris .secteur__etat{color:var(--fg-dim)}.secteur--pris .secteur__nom{color:var(--fg-dim);text-decoration:line-through}
  .porte__titre{text-wrap:balance}
  .paliers-accueil__note{margin:var(--e4) 0 0}
  .paliers-accueil{list-style:none;margin:var(--e6) 0 0;padding:0;display:grid;gap:1px;background:var(--trait);grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));clip-path:var(--chanfrein);--c:14px}
  .paliers-accueil li{background:var(--bg);border-top:8px solid var(--f)}
  .paliers-accueil a{display:grid;gap:.5em;height:100%;padding:var(--e5) var(--e4);text-decoration:none;color:var(--fg);align-content:start;transition:background-color .3s var(--ease)}
  .paliers-accueil a:hover{background:var(--bloc)}
  .paliers-accueil .chevs .chev{width:.5em;height:.5em;background:var(--fg-dim)}
  .paliers-accueil b{font-family:var(--f-titre);font-weight:900;text-transform:uppercase;line-height:1;font-size:var(--t-h4)}
  .paliers-accueil__montant{font-family:var(--f-titre);font-weight:900;font-size:var(--t-h3);line-height:1;font-variant-numeric:tabular-nums}
  .paliers-accueil__montant small{font-family:var(--f-corps);font-weight:700;font-size:var(--t-micro);letter-spacing:.12em;text-transform:uppercase;color:var(--fg-dim)}
  .paliers-accueil__pour{font-size:var(--t-petit);color:var(--fg-dim);line-height:1.45}
  .paliers-accueil__lien{margin-top:auto;padding-top:var(--e3);font-weight:700;color:var(--t-bleu);display:inline-flex;align-items:center;gap:.4em}
  /* Téléphone : le nom au-dessus, le statut dessous — aucun mot coupé en deux. */
  @media (max-width:39.99em){
    .secteurs{grid-template-columns:repeat(2,minmax(0,1fr))}
    .secteur{flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:.45em}
    .secteur__nom{font-size:clamp(1rem,.8rem + 1.2vw,1.25rem)}
  }
  .secteur{min-width:0}
</style>
