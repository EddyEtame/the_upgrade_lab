---
/** /en/le-programme/ — what the programme is. "basketball academy Douala" is an
 *  INTENT a parent types; the page answers with what is true today. */
import Base from '../../../layouts/Base.astro';
import { FAITS, PARCOURS, TERRAIN_3X3 } from '../../../data/site';
import { EN, COMPOSANTES_EN, VALEURS_EN, PROMESSES_EN, PENDING_EN } from '../../../data/en';

const faq = [
  { q: 'Is The Upgrade Lab a club or a basketball academy?', a: `A development programme: a structure that takes young people aged ${FAITS.ageMin} to ${FAITS.ageMax}, trains them along a written five-level pathway, and supports them toward higher clubs, academies and scholarships. The programme is launching in Douala.` },
  { q: 'Is the programme affiliated with a federation?', a: 'No federal affiliation exists to date. The programme says so plainly: claiming one would be a false fact, and affiliations will be announced on this page the day they exist.' },
  { q: 'Who is the programme for?', a: `Girls and boys aged ${FAITS.ageMin} to ${FAITS.ageMax}, in six categories: ${FAITS.categories.join(', ')}. Entry is at the Discover level, whatever the age, with no prior level required.` }
];
---

<Base titre="The programme" description="The Upgrade Lab, the basketball academy Douala families search for, in everything but the title: nine components, eight values, a five-level pathway, and a regulation court for an Olympic discipline." lang="en" typePage="AboutPage" fil={[{ nom: 'The programme', href: '/en/le-programme/' }]} faq={faq}>
  <section class="section"><div class="conteneur">
    <p class="balise"><span class="chev" aria-hidden="true"></span>The programme · {EN.statut}</p>
    <h1><span class="obl">Looking for a basketball academy in Douala?</span><br />Here is what exists, written down</h1>
    <p class="chapo mesure">The Upgrade Lab is a youth basketball development programme in Douala. It takes young people aged {FAITS.ageMin} to {FAITS.ageMax}, girls and boys, moves them through five levels, and supports them toward higher clubs, academies and scholarships.</p>
    <p class="mesure">Plenty of young people in Douala have the talent. What they lack is not appetite: it is regular training, qualified supervision, equipment, competition, and someone tracking their progress. Without those, talent stays potential and quietly goes out. The programme answers with a method — a written pathway, observable criteria — and not with promises.</p>
    <p class="mesure">A partner therefore does not fund a team. They fund a mechanism that turns potential into performance, and that produces disciplined, schooled, employable young people along the way.</p>
  </div></section>

  <section class="section sur-bloc" aria-labelledby="t-c"><div class="conteneur">
    <h2 id="t-c">Nine components, <span class="obl">one programme</span></h2>
    <p class="mesure t-sourd">Basketball, physical preparation, school, mentoring, competition, exposure: none of these stands alone. It is the articulation that makes the training centre a parent has in mind when they type those words.</p>
    <ol class="composantes" role="list">{COMPOSANTES_EN.map((c, i) => <li class="carte composante"><p class="composante__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p><h3>{c.titre}</h3><p>{c.texte}</p></li>)}</ol>
  </div></section>

  <section class="section" aria-labelledby="t-p"><div class="conteneur"><div class="grille-2" style="--gap:2.5rem">
    <div><h2 id="t-p">The pathway, <span class="obl">in five levels</span></h2><p class="mesure">A young player does not “join” the programme: they enter at a level, and cross it. Each stage has content, an objective and an exit, published on its page.</p><a class="bouton fantome" href="/en/le-parcours/">The pathway, level by level <span class="chev" aria-hidden="true"></span></a></div>
    <ol class="bande" role="list">{PARCOURS.map((n) => <li style={`--fill:${n.fill};--txt:${n.texteSurNoir}`}><a href={`/en${n.href}`}><b>{n.label}</b><span>{PROMESSES_EN[n.key].promesse}</span></a></li>)}</ol>
  </div></div></section>

  <section class="section sur-bloc" aria-labelledby="t-t"><div class="conteneur">
    <h2 id="t-t">The court: <span class="obl t-ambre">regulation, and Olympic</span></h2>
    <p class="mesure">{EN.terrain}</p>
    <p class="mesure">{EN.etude} A shorter court is not a lesser court. For a child, it is a better one.</p>
  </div></section>

  <section class="section" aria-labelledby="t-v"><div class="conteneur">
    <h2 id="t-v">Eight values, <span class="obl">written once</span></h2>
    <dl class="valeurs">{VALEURS_EN.map(([v, t]) => <div class="valeur"><dt>{v}</dt><dd>{t}</dd></div>)}</dl>
  </div></section>

  <section class="section serree sur-bloc" aria-labelledby="t-s"><div class="conteneur">
    <h2 id="t-s">What this page will soon say</h2>
    <p class="mesure t-sourd">Two pieces of information are being established and will take their place here, with the date they were verified.</p>
    <div class="grille" style="--min:16rem;--gap:1px">{['effectifs', 'encadrants'].map((k) => <p class="fente"><b>{PENDING_EN[k].label}</b><span>{PENDING_EN[k].source}</span></p>)}</div>
    <p class="petit t-sourd" style="margin-top:var(--e4)">The programme has no federal affiliation to date; it says so rather than letting it be assumed.</p>
  </div></section>
</Base>

<style>
  .composantes{list-style:none;margin:var(--e6) 0 0;padding:0;display:grid;gap:var(--e4);grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))}
  .composante{--c:14px}.composante__num{font-family:var(--f-titre);font-weight:900;font-size:var(--t-h2);line-height:1;color:var(--t-bleu);margin:0 0 .35em}
  .composante h3{margin:0 0 .35em;font-size:var(--t-h4)}.composante p{margin:0;font-size:var(--t-petit);line-height:1.5;color:var(--fg-dim)}
  .bande{list-style:none;margin:0;padding:0;display:grid;gap:1px;background:var(--trait);clip-path:var(--chanfrein);--c:12px}
  .bande li{background:var(--bg);border-left:6px solid var(--fill)}.bande a{display:grid;gap:.15em;padding:var(--e4);text-decoration:none;color:var(--fg)}.bande a:hover{background:var(--bloc)}
  .bande b{font-family:var(--f-titre);font-weight:900;text-transform:uppercase;font-size:var(--t-h4);color:var(--txt);line-height:1}.bande span{font-size:var(--t-petit);color:var(--fg-dim)}
  .valeurs{margin:var(--e6) 0 0;display:grid;gap:1px;background:var(--trait);grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));clip-path:var(--chanfrein);--c:12px}
  .valeur{background:var(--bg);padding:var(--e4)}.valeur dt{font-family:var(--f-titre);font-weight:900;text-transform:uppercase;font-size:var(--t-h4);color:var(--t-ambre);margin:0 0 .3em;line-height:1}.valeur dd{margin:0;font-size:var(--t-petit);line-height:1.5;color:var(--fg-dim)}
</style>
