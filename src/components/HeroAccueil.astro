---
/**
 * HeroAccueil.astro — l'ouverture du site.
 *
 * ---------------------------------------------------------------------------
 * LA THÈSE, et elle est posée dès la première ligne visible.
 *
 * Une dalle de béton à Douala n'est pas un terrain de 5-contre-5 déficient.
 * Quinze mètres sur onze, un panier, une raquette réglementaire, une ligne de
 * lancer franc et l'arc à 6,75 m : c'est le format FIBA 3x3, et le 3x3 est une
 * discipline olympique depuis Tokyo 2020. Le hero ne raconte donc pas un
 * manque à combler, il annonce une légitimité déjà acquise.
 * ---------------------------------------------------------------------------
 *
 * AUCUNE PHOTOGRAPHIE. Le programme entraîne des mineurs (Annexe A), et la
 * page devait être extraordinaire sans image d'enfant. L'illustration est donc
 * PROCÉDURALE : un plan du terrain FIBA 3x3 tracé en SVG, à l'échelle réelle —
 * une unité du viewBox = un décimètre. Le dessin n'est pas une décoration,
 * c'est la démonstration. Coût : ~1,5 Ko de balisage, zéro requête, net à
 * toutes les tailles, et il se relit à l'impression.
 *
 * COULEUR. Les lignes du terrain sont peintes avec l'ambre du logo (#F89800) —
 * un APLAT vectoriel, jamais du texte ; c'est exactement ce que l'ambre décrit
 * dans le logo d'origine, les lignes du terrain. Les cotes, elles, sont du
 * TEXTE : elles lisent la rampe (--t-ambre, 8.17:1 sur noir). La règle du
 * projet tient dans ce seul paragraphe.
 *
 * Zéro JavaScript, et rien à charger : tout est dans le document.
 */

import { FAITS, TERRAIN_3X3 } from '../data/site';

/* Les quatre faits confirmés que le hero a le droit d'afficher. Aucun effectif,
   aucun tarif, aucune adresse : ceux-là sont EN_ATTENTE et se dessinent en
   fente plus bas dans la page, jamais dans l'accroche. */
const faits = [
  {
    valeur: `${FAITS.ageMin} → ${FAITS.ageMax} ans`,
    note: 'l’âge d’entrée, et l’âge où l’on part vers plus haut'
  },
  {
    valeur: 'Filles et garçons',
    note: 'le programme se construit pour les deux, sans catégorie réservée'
  },
  {
    valeur: `${FAITS.categories.length} catégories`,
    note: FAITS.categories.join(' · ')
  },
  {
    valeur: `${FAITS.nombreNiveaux} niveaux`,
    note: 'de Discover à Progress, et on sait toujours où l’on en est'
  }
];
---

<section class="hero sur-noir" aria-labelledby="titre-accueil">
  <div class="conteneur">

    <div class="hero__grille">

      <!-- 1 · le mot -->
      <div class="hero__mot">
        <p class="etiquette hero__lieu">
          <span class="chev" aria-hidden="true"></span>
          Douala · Littoral · Cameroun
        </p>

        <h1 id="titre-accueil" class="hero__titre">
          <span class="hero__ligne"><span class="obl">Quinze mètres</span></span>
          <span class="hero__ligne"><span class="obl">sur onze,</span></span>
          <span class="hero__ligne"><span class="obl">un panier :</span></span>
          <span class="hero__ligne hero__ligne--accent">
            <span class="obl">une discipline olympique.</span>
          </span>
        </h1>

        <p class="chapo hero__chapo">
          The Upgrade Lab entraîne les filles et les garçons de Douala, de 10 à
          20 ans, sur la surface qu’ils ont déjà sous les pieds — et cette
          surface est un terrain réglementaire.
        </p>

        <p class="hero__texte">
          Vous cherchez un club de basket à Douala pour votre enfant, ou un
          programme sérieux à soutenir : ici, le chemin est écrit en cinq
          niveaux, de la première prise de ballon jusqu’à la porte d’un club
          supérieur.
        </p>

        <div class="hero__actions">
          <a class="bouton primaire" href="/rejoindre/">
            <span>Rejoindre le programme</span>
            <span class="chev" aria-hidden="true"></span>
          </a>
          <a class="bouton fantome" href="/le-parcours/">
            <span>Voir les cinq niveaux</span>
            <span class="chev" aria-hidden="true"></span>
          </a>
        </div>

        <p class="petit hero__entreprise">
          Vous représentez une entreprise&nbsp;?
          <a href="/sponsors/">Ce qu’un partenaire finance, palier par palier</a>.
        </p>
      </div>

      <!-- 2 · la preuve, tracée -->
      <figure class="plaque">
        <div class="plaque__cadre cut">
          <svg
            class="terrain"
            viewBox="-8 -12 206 156"
            role="img"
            aria-labelledby="terrain-titre terrain-desc"
          >
            <title id="terrain-titre">
              Plan d’un terrain FIBA 3x3, tracé à l’échelle
            </title>
            <desc id="terrain-desc">
              Rectangle de 15 mètres sur 11, un seul panier sur la ligne de
              fond, la raquette et la ligne de lancer franc réglementaires, et
              l’arc à 6,75 mètres qui sert de ligne à deux points.
            </desc>

            {/* Le rectangle de jeu : 150 x 110 unités = 15 m x 11 m. */}
            <rect class="ligne ligne--fort" x="0" y="0" width="150" height="110" />

            {/* La raquette : 4,90 m de large, 5,80 m depuis la ligne de fond. */}
            <rect class="ligne" x="0" y="30.5" width="58" height="49" />

            {/* Le demi-cercle de lancer franc, rayon 1,80 m. */}
            <path class="ligne" d="M58 37 A18 18 0 0 1 58 73" />

            {/* L'arc à deux points : rayon 6,75 m depuis l'axe du panier. Il
                sort par les deux lignes de touche, comme sur un vrai tracé. */}
            <path class="ligne ligne--fort" d="M54.9 0 A67.5 67.5 0 0 1 54.9 110" />

            {/* Zone de non-charge, rayon 1,25 m. */}
            <path class="ligne ligne--fin" d="M15.75 42.5 A12.5 12.5 0 0 1 15.75 67.5" />

            {/* Le panneau (1,80 m) et l'anneau, à 1,575 m de la ligne de fond. */}
            <path class="panneau" d="M12 46 V64" />
            <circle class="anneau" cx="15.75" cy="55" r="2.3" />

            {/* Les cotes. Ce sont les seuls textes du dessin, et ils lisent la
                rampe sombre — pas l'aplat des lignes. */}
            <g class="cote">
              <path d="M0 124 H150 M0 120 V128 M150 120 V128" />
              <path d="M162 0 V110 M158 0 H166 M158 110 H166" />
              <path d="M15.75 55 H83.25 M83.25 51 V59" />
            </g>
            <text x="75" y="138" text-anchor="middle">15 m</text>
            <text x="170" y="55" dominant-baseline="middle">11 m</text>
            <text x="49.5" y="49" text-anchor="middle">6,75 m</text>
          </svg>
        </div>

        <figcaption class="plaque__legende">
          <span class="t-ambre plaque__gras">Terrain FIBA 3x3 réglementaire.</span>
          {' '}
          {TERRAIN_3X3.longueurM} m sur {TERRAIN_3X3.largeurM} m, un panier, arc
          à {String(TERRAIN_3X3.arcM).replace('.', ',')} m. Discipline olympique
          depuis {TERRAIN_3X3.premiereOlympiade}.
        </figcaption>
      </figure>

    </div>

    <!-- 3 · les faits, et rien que les faits confirmés -->
    <ul class="faits" role="list">
      {faits.map((f) => (
        <li>
          <b>{f.valeur}</b>
          <span>{f.note}</span>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .hero{
    position:relative;
    overflow:hidden;
    padding-block:clamp(2.5rem,1.4rem+4.4vw,5rem) var(--e9);
    border-bottom:1px solid var(--trait);
  }

  /* Un seul trait décoratif, penché des 9 degrés du logo. Il tient la
     diagonale du bloc sans coûter une image. */
  .hero::before{
    content:'';
    position:absolute;
    inset:auto -20% -14rem 40%;
    height:28rem;
    background:linear-gradient(
      to right,
      color-mix(in srgb,var(--blue) 14%,transparent),
      transparent 70%);
    transform:skewX(calc(-1 * var(--oblique)));
    pointer-events:none;
  }

  .hero__grille{
    position:relative;
    display:grid;
    gap:var(--e7);
    align-items:center;
  }
  @media (min-width:62em){
    .hero__grille{
      grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);
      gap:var(--e8);
    }
  }

  /* --- le mot --- */
  .hero__lieu{
    display:flex;
    align-items:center;
    gap:.6em;
    margin:0 0 var(--e4);
  }
  .hero__lieu .chev{width:.62em;height:.62em;color:var(--t-bleu)}

  .hero__titre{
    font-size:clamp(2.5rem,1.15rem + 5.4vw,5rem);
    line-height:.93;
    margin:0 0 var(--e5);
    text-wrap:balance;
  }
  .hero__ligne{display:block}
  .hero__ligne--accent{color:var(--t-ambre)}

  .hero__chapo{margin:0 0 var(--e4);max-width:36ch}
  .hero__texte{
    max-width:52ch;
    color:var(--fg-dim);
    margin:0;
  }

  .hero__actions{
    display:flex;
    flex-wrap:wrap;
    gap:var(--e4);
    margin-top:var(--e6);
  }
  .hero__entreprise{
    margin:var(--e4) 0 0;
    color:var(--fg-dim);
  }
  .hero__entreprise a{
    color:var(--t-bleu);
    text-decoration:underline;
  }
  .hero__entreprise a:hover{color:var(--fg)}

  /* --- la plaque : le terrain, tracé --- */
  .plaque{margin:0}
  .plaque__cadre{
    --c:24px;
    background:var(--bloc);
    padding:clamp(1rem,.4rem + 2.2vw,2.25rem);
  }
  .terrain{display:block;width:100%;height:auto}

  /* Les lignes du terrain : APLAT ambre du logo. C'est du vecteur, pas du
     type — 9.48:1 sur noir, très au-dessus du 3:1 exigé d'un graphique. */
  .terrain :global(.ligne){
    fill:none;
    stroke:var(--amber);
    stroke-width:1.3;
    stroke-linejoin:miter;
  }
  .terrain :global(.ligne--fort){stroke-width:2.4}
  .terrain :global(.ligne--fin){stroke-width:1;opacity:.62}
  .terrain :global(.panneau){
    fill:none;
    stroke:var(--steel);
    stroke-width:3;
    stroke-linecap:butt;
  }
  .terrain :global(.anneau){
    fill:none;
    stroke:var(--ball);
    stroke-width:2.2;
  }
  /* Les cotes sont un appareil de mesure, pas le terrain : elles s'effacent. */
  .terrain :global(.cote){
    fill:none;
    stroke:var(--fg-dim);
    stroke-width:.9;
  }
  .terrain text{
    font-family:var(--f-corps);
    font-weight:700;
    font-size:9px;
    letter-spacing:.05em;
    fill:var(--t-ambre);
  }

  .plaque__legende{
    margin-top:var(--e4);
    font-size:var(--t-petit);
    line-height:1.5;
    color:var(--fg-dim);
    max-width:46ch;
  }
  .plaque__gras{font-weight:700}

  /* --- la barre de faits --- */
  /* Grille à gouttière d'un pixel sur fond de trait : les filets sont la
     grille elle-même, et ne coûtent aucune bordure à dessiner. */
  .faits{
    position:relative;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:1px;
    background:var(--trait);
    list-style:none;
    margin:var(--e8) 0 0;
    padding:0;
    clip-path:var(--chanfrein);
    --c:12px;
  }
  @media (min-width:52em){
    .faits{grid-template-columns:repeat(4,1fr)}
  }
  .faits li{
    background:var(--bg);
    padding:var(--e4) var(--e4) calc(var(--e4) + .2rem);
  }
  .faits b{
    display:block;
    font-family:var(--f-titre);
    font-weight:900;
    text-transform:uppercase;
    font-size:var(--t-h4);
    line-height:1;
    letter-spacing:-.005em;
    color:var(--fg);
  }
  .faits span{
    display:block;
    margin-top:.45em;
    font-size:var(--t-petit);
    line-height:1.45;
    color:var(--fg-dim);
  }

  @media (max-width:47.99em){
    .hero::before{display:none}
    .hero__titre{font-size:clamp(2.25rem,1.3rem + 4.6vw,3.25rem)}
  }
</style>
