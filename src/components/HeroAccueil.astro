---
/**
 * Le hero de l'accueil — et il vend le partenariat, parce que c'est la Phase 0.
 *
 * Le premier lecteur de cette page est une entreprise de Douala, pas un
 * parent. Elle doit comprendre en une ligne le mécanisme (un secteur, un
 * partenaire, une saison), voir que la vacance est publiée, et avoir le bouton
 * sous la main. Le parent a sa porte une ligne plus bas — visible, jamais
 * cachée, mais seconde.
 *
 * Le terrain reste la preuve dessinée : c'est ce que l'argent finance.
 * Rien ici n'est un effectif, un tarif approuvé ou une adresse.
 *
 * Mouvement : entrée chorégraphiée à l'ouverture (lignes du titre, texte,
 * boutons, tracé du terrain qui se dessine, faits, ruban). Tout en CSS,
 * neutralisé par prefers-reduced-motion. Le tracé utilise pathLength="1"
 * pour que chaque ligne se dessine sur la même unité.
 */
import { FAITS, TERRAIN_3X3, type CodeLangue } from '../data/site';
import { NB_OUVERTS, SECTEURS, VACANCE_A_JOUR_LE, VACANCE_A_JOUR_LE_FR, PALIER_EXCLUSIVITE } from '../data/offre';

export interface Props { lang?: CodeLangue }
const { lang = 'fr' } = Astro.props;
const fr = lang === 'fr';
const p = (h: string) => (fr ? h : `/en${h}`);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const dateEN = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(VACANCE_A_JOUR_LE + 'T00:00:00Z'));
const date = fr ? VACANCE_A_JOUR_LE_FR : dateEN;
const nbSecteurs = SECTEURS.length;
const secteurs = SECTEURS.map((s) => (fr ? s.nom : s.nomEn));

const T = fr
  ? {
      lieu: 'Douala · Littoral · Cameroun',
      offre: 'Offre de partenariat',
      l1: 'Huit secteurs', l2: 'à Douala,', l3: 'un seul partenaire', l4: 'par secteur.',
      chapo: `The Upgrade Lab, club de basket à Douala pour les ${FAITS.ageMin} à ${FAITS.ageMax} ans, propose à ${nbSecteurs} secteurs d’activité un partenariat exclusif pour la saison. ${NB_OUVERTS} secteurs sont encore ouverts au ${date}.`,
      texte: 'Vous financez un mécanisme — cinq niveaux, des critères de passage publiés, deux rapports écrits par saison — pas une équipe. Et le secteur que vous laissez passer, un concurrent peut le prendre.',
      cta1: 'Devenir partenaire', cta2: 'Parrainer un athlète',
      parent: 'Vous êtes un parent, ou un jeune ?', parentLien: 'Tout commence par une séance d’essai',
      legendeGras: 'Le terrain que vous financez.',
      legende: `Terrain FIBA 3x3 réglementaire, ${TERRAIN_3X3.longueurM} m sur ${TERRAIN_3X3.largeurM} m, un panier, arc à ${String(TERRAIN_3X3.arcM).replace('.', ',')} m. Discipline olympique depuis ${TERRAIN_3X3.premiereOlympiade}.`,
      svgTitre: 'Plan d’un terrain FIBA 3x3, tracé à l’échelle',
      svgDesc: 'Rectangle de 15 mètres sur 11, un seul panier sur la ligne de fond, la raquette et la ligne de lancer franc réglementaires, et l’arc à 6,75 mètres qui sert de ligne à deux points.',
      arc: '6,75 m',
      faits: [
        { v: `${nbSecteurs} secteurs`, n: `exclusivité de saison dès le palier ${cap(PALIER_EXCLUSIVITE)}` },
        { v: `${NB_OUVERTS} ouverts`, n: `au ${date} — la vacance est publiée, jamais mise en scène` },
        { v: '4 paliers + 1', n: 'des contreparties écrites, reprises telles quelles dans la convention' },
        { v: '2 rapports', n: 'par saison : ce que vous rapportez à votre conseil' }
      ],
      ruban: 'Secteurs proposés'
    }
  : {
      lieu: 'Douala · Littoral · Cameroon',
      offre: 'Partnership offer',
      l1: 'Eight sectors', l2: 'in Douala,', l3: 'one partner', l4: 'per sector.',
      chapo: `The Upgrade Lab, a basketball club in Douala for ages ${FAITS.ageMin} to ${FAITS.ageMax}, offers ${nbSecteurs} business sectors an exclusive partnership for the season. ${NB_OUVERTS} sectors are still open as of ${date}.`,
      texte: 'You fund a mechanism — five levels, published promotion criteria, two written reports a season — not a team. And the sector you let go, a competitor can take.',
      cta1: 'Become a partner', cta2: 'Sponsor an athlete',
      parent: 'A parent, or a young player?', parentLien: 'It all starts with a trial session',
      legendeGras: 'The court you fund.',
      legende: `Regulation FIBA 3x3 court, ${TERRAIN_3X3.longueurM} by ${TERRAIN_3X3.largeurM} m, one basket, arc at ${TERRAIN_3X3.arcM} m. An Olympic discipline since ${TERRAIN_3X3.premiereOlympiade}.`,
      svgTitre: 'Plan of a FIBA 3x3 court, drawn to scale',
      svgDesc: 'A 15 by 11 metre rectangle, a single basket on the baseline, the regulation key and free-throw line, and the 6.75 metre arc used as the two-point line.',
      arc: '6.75 m',
      faits: [
        { v: `${nbSecteurs} sectors`, n: `season exclusivity from the ${cap(PALIER_EXCLUSIVITE)} tier` },
        { v: `${NB_OUVERTS} open`, n: `as of ${date} — availability is published, never staged` },
        { v: '4 tiers + 1', n: 'written deliverables, carried unchanged into the agreement' },
        { v: '2 reports', n: 'per season: what you take back to your board' }
      ],
      ruban: 'Sectors offered'
    };
---

<section class="hero sur-noir" aria-labelledby="titre-accueil">
  <div class="conteneur">
    <div class="hero__grille">
      <div class="hero__mot">
        <p class="etiquette hero__lieu">
          <span class="chev" aria-hidden="true"></span>
          {T.lieu}<span class="hero__sep" aria-hidden="true"> · </span><span class="t-ambre">{T.offre}</span>
        </p>

        <h1 id="titre-accueil" class="hero__titre">
          <span class="hero__ligne"><span class="obl">{T.l1}</span></span>
          <span class="hero__ligne"><span class="obl">{T.l2}</span></span>
          <span class="hero__ligne"><span class="obl">{T.l3}</span></span>
          <span class="hero__ligne hero__ligne--accent"><span class="obl">{T.l4}</span></span>
        </h1>

        <p class="chapo hero__chapo hero__entre">{T.chapo}</p>
        <p class="hero__texte hero__entre">{T.texte}</p>

        <div class="hero__actions hero__entre">
          <a class="bouton primaire" href={p('/sponsors/')}>
            <span>{T.cta1}</span>
            <span class="chev" aria-hidden="true"></span>
          </a>
          <a class="bouton fantome" href={p('/sponsors/bourse/')}>
            <span>{T.cta2}</span>
            <span class="chev" aria-hidden="true"></span>
          </a>
        </div>

        <p class="petit hero__entreprise hero__entre">
          {T.parent} <a href={p('/rejoindre/')}>{T.parentLien}</a>.
        </p>
      </div>

      <figure class="plaque">
        <div class="plaque__cadre cut">
          <svg class="terrain" viewBox="-8 -12 206 156" role="img" aria-labelledby="terrain-titre terrain-desc">
            <title id="terrain-titre">{T.svgTitre}</title>
            <desc id="terrain-desc">{T.svgDesc}</desc>
            <rect class="ligne ligne--fort" x="0" y="0" width="150" height="110" pathLength="1" />
            <rect class="ligne" x="0" y="30.5" width="58" height="49" pathLength="1" />
            <path class="ligne" d="M58 37 A18 18 0 0 1 58 73" pathLength="1" />
            <path class="ligne ligne--fort" d="M54.9 0 A67.5 67.5 0 0 1 54.9 110" pathLength="1" />
            <path class="ligne ligne--fin" d="M15.75 42.5 A12.5 12.5 0 0 1 15.75 67.5" pathLength="1" />
            <path class="panneau" d="M12 46 V64" pathLength="1" />
            <circle class="anneau" cx="15.75" cy="55" r="2.3" pathLength="1" />
            <g class="cote">
              <path d="M0 124 H150 M0 120 V128 M150 120 V128" />
              <path d="M162 0 V110 M158 0 H166 M158 110 H166" />
              <path d="M15.75 55 H83.25 M83.25 51 V59" />
            </g>
            <text x="75" y="138" text-anchor="middle">15 m</text>
            <text x="170" y="55" dominant-baseline="middle">11 m</text>
            <text x="49.5" y="49" text-anchor="middle">{T.arc}</text>
          </svg>
        </div>
        <figcaption class="plaque__legende">
          <span class="t-ambre plaque__gras">{T.legendeGras}</span> {T.legende}
        </figcaption>
      </figure>
    </div>

    <ul class="faits" role="list">
      {T.faits.map((f, i) => {
        const m = f.v.match(/^(\d+)(.*)$/);
        return <li><b>{m ? <><span class="compte" data-compte={m[1]} data-delai={String(700 + i * 90)}>{m[1]}</span>{m[2]}</> : f.v}</b><span>{f.n}</span></li>;
      })}
    </ul>
  </div>

  <div class="ruban" aria-label={T.ruban}>
    <div class="ruban__piste">
      {[0, 1].map((k) => (
        <ul class="ruban__liste" role="list" aria-hidden={k === 1 ? 'true' : undefined}>
          {secteurs.map((s) => <li><span class="chev" aria-hidden="true"></span>{s}</li>)}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .hero{position:relative;overflow:hidden;padding-block:clamp(2.5rem,1.4rem+4.4vw,5rem) 0;border-bottom:1px solid var(--trait)}
  .hero::before{content:'';position:absolute;inset:auto -20% -14rem 40%;height:28rem;
    background:linear-gradient(to right,color-mix(in srgb,var(--blue) 14%,transparent),transparent 70%);
    transform:skewX(calc(-1 * var(--oblique)));pointer-events:none}
  .hero__grille{position:relative;display:grid;gap:var(--e7);align-items:center}
  @media (min-width:62em){.hero__grille{grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);gap:var(--e8)}}

  .hero__lieu{display:flex;flex-wrap:wrap;align-items:center;gap:.6em;margin:0 0 var(--e4)}
  .hero__lieu .chev{width:.62em;height:.62em;color:var(--t-bleu)}
  .hero__sep{color:var(--fg-dim)}
  .hero__titre{font-size:clamp(2.5rem,1.15rem + 5.4vw,5rem);line-height:.93;margin:0 0 var(--e5);text-wrap:balance}
  .hero__ligne{display:block;overflow:hidden;padding-block:.04em}
  .hero__ligne .obl{display:inline-block}
  .hero__ligne--accent{color:var(--t-ambre)}
  .hero__chapo{margin:0 0 var(--e4);max-width:36ch}
  .hero__texte{max-width:52ch;color:var(--fg-dim);margin:0}
  .hero__actions{display:flex;flex-wrap:wrap;gap:var(--e4);margin-top:var(--e6)}
  .hero__entreprise{margin:var(--e4) 0 0;color:var(--fg-dim)}
  .hero__entreprise a{color:var(--t-bleu);text-decoration:underline}
  .hero__entreprise a:hover{color:var(--fg)}

  .plaque{margin:0}
  .plaque__cadre{--c:24px;background:var(--bloc);padding:clamp(1rem,.4rem + 2.2vw,2.25rem)}
  .terrain{display:block;width:100%;height:auto}
  .terrain :global(.ligne){fill:none;stroke:var(--amber);stroke-width:1.3;stroke-linejoin:miter}
  .terrain :global(.ligne--fort){stroke-width:2.4}
  .terrain :global(.ligne--fin){stroke-width:1;opacity:.62}
  .terrain :global(.panneau){fill:none;stroke:var(--steel);stroke-width:3;stroke-linecap:butt}
  .terrain :global(.anneau){fill:none;stroke:var(--ball);stroke-width:2.2}
  .terrain :global(.cote){fill:none;stroke:var(--fg-dim);stroke-width:.9}
  .terrain text{font-family:var(--f-corps);font-weight:700;font-size:9px;letter-spacing:.05em;fill:var(--t-ambre)}
  .plaque__legende{margin-top:var(--e4);font-size:var(--t-petit);line-height:1.5;color:var(--fg-dim);max-width:46ch}
  .plaque__gras{font-weight:700}

  .faits{position:relative;display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--trait);list-style:none;margin:var(--e8) 0 0;padding:0;clip-path:var(--chanfrein);--c:12px}
  @media (min-width:52em){.faits{grid-template-columns:repeat(4,1fr)}}
  .faits li{background:var(--bg);padding:var(--e4) var(--e4) calc(var(--e4) + .2rem)}
  .faits b{display:block;font-family:var(--f-titre);font-weight:900;text-transform:uppercase;font-size:var(--t-h4);line-height:1;letter-spacing:-.005em;color:var(--fg)}
  .faits .compte{display:inline;font-variant-numeric:tabular-nums;margin:0;font-size:inherit;color:inherit;line-height:inherit}
  .faits li > span{display:block;margin-top:.45em;font-size:var(--t-petit);line-height:1.45;color:var(--fg-dim)}

  /* Le ruban : les huit secteurs défilent, la marque tient la ligne. */
  .ruban{margin-top:var(--e6);border-top:1px solid var(--trait);overflow:hidden;
    -webkit-mask-image:linear-gradient(to right,transparent,#000 8%,#000 92%,transparent);
    mask-image:linear-gradient(to right,transparent,#000 8%,#000 92%,transparent)}
  .ruban__piste{display:flex;width:max-content}
  .ruban__liste{display:flex;list-style:none;margin:0;padding:.9rem 0;flex:none}
  .ruban__liste li{display:flex;align-items:center;gap:.55em;padding:0 1.6rem;white-space:nowrap;
    font-family:var(--f-titre);font-weight:700;text-transform:uppercase;letter-spacing:.06em;font-size:1rem;color:var(--fg-dim)}
  .ruban__liste .chev{width:.5em;height:.5em;color:var(--t-ambre)}

  @media (max-width:47.99em){.hero::before{display:none}.hero__titre{font-size:clamp(2.25rem,1.3rem + 4.6vw,3.25rem)}}

  /* ---- L'entrée. Une seule fois, à l'ouverture, et rien n'attend. ---- */
  @media (prefers-reduced-motion:no-preference){
    @keyframes ligne-entre{from{transform:translateY(110%) skewX(calc(-1 * var(--oblique)))}to{transform:none}}
    @keyframes monte{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
    @keyframes rideau{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}
    @keyframes trace{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
    @keyframes defile{to{transform:translateX(-50%)}}
    .hero__ligne .obl{animation:ligne-entre .9s var(--ease) both}
    .hero__ligne:nth-child(1) .obl{animation-delay:.05s}
    .hero__ligne:nth-child(2) .obl{animation-delay:.14s}
    .hero__ligne:nth-child(3) .obl{animation-delay:.23s}
    .hero__ligne:nth-child(4) .obl{animation-delay:.32s}
    .hero__lieu{animation:monte .7s var(--ease) both}
    .hero__entre{animation:monte .8s var(--ease) both}
    .hero__chapo{animation-delay:.42s}.hero__texte{animation-delay:.5s}.hero__actions{animation-delay:.58s}.hero__entreprise{animation-delay:.66s}
    .plaque{animation:rideau 1.1s cubic-bezier(.76,0,.24,1) .2s both}
    .terrain :global(.ligne),.terrain :global(.panneau),.terrain :global(.anneau){stroke-dasharray:1;stroke-dashoffset:1;animation:trace 1.4s var(--ease) both}
    .terrain :global(.ligne--fort:first-of-type){animation-delay:.45s}
    .terrain :global(.ligne):nth-of-type(2){animation-delay:.75s}
    .terrain :global(.ligne):nth-of-type(3){animation-delay:.9s}
    .terrain :global(.ligne):nth-of-type(4){animation-delay:.6s}
    .terrain :global(.ligne--fin){animation-delay:1.05s}
    .terrain :global(.panneau){animation-delay:1.15s}
    .terrain :global(.anneau){animation-delay:1.3s}
    .faits li{animation:monte .8s var(--ease) both}
    .faits li:nth-child(1){animation-delay:.7s}.faits li:nth-child(2){animation-delay:.78s}.faits li:nth-child(3){animation-delay:.86s}.faits li:nth-child(4){animation-delay:.94s}
    .ruban__piste{animation:defile 38s linear infinite}
    .ruban:hover .ruban__piste{animation-play-state:paused}
  }
</style>
