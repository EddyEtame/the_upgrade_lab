---
/**
 * TableVacance.astro — the eight sectors, open or taken. Bilingual.
 *
 * The site's commercial mechanism: a CSR director offered a sector a
 * competitor could take decides against competitors, not against every other
 * donation request. The table never lies in the convenient direction — the
 * data lives in offre.ts, one field to change on the day of a signature.
 *
 * A real <table>: readable by an answer engine and by a human, and it prints.
 */

import { SECTEURS, VACANCE_A_JOUR_LE, VACANCE_A_JOUR_LE_FR, NB_OUVERTS, NB_SECTEURS, PALIER_EXCLUSIVITE } from '../data/offre';
import { SECTEURS_EN } from '../data/en';

export interface Props { compact?: boolean; lang?: 'fr' | 'en' }
const { compact = false, lang = 'fr' } = Astro.props;
const fr = lang === 'fr';
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const dateEN = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(VACANCE_A_JOUR_LE + 'T00:00:00Z'));
const T = fr
  ? { legende: `Vacance des ${NB_SECTEURS} secteurs de partenariat, vérifiée le ${VACANCE_A_JOUR_LE_FR}`, secteur: 'Secteur', statut: 'Statut', pourquoi: 'Pourquoi ce secteur', ouvert: 'Ouvert', pris: 'Pris', depuis: 'depuis', reserve: 'Réserve écrite au contrat.',
      pied: `${NB_OUVERTS} secteurs sur ${NB_SECTEURS} ouverts au ${VACANCE_A_JOUR_LE_FR}. L’exclusivité de secteur est acquise à partir du palier ${cap(PALIER_EXCLUSIVITE)}. Un secteur passe à « pris » le jour d’une signature, jamais avant.` }
  : { legende: `Availability of the ${NB_SECTEURS} partnership sectors, checked on ${dateEN}`, secteur: 'Sector', statut: 'Status', pourquoi: 'Why this sector', ouvert: 'Open', pris: 'Taken', depuis: 'since', reserve: 'Written into the contract.',
      pied: `${NB_OUVERTS} of ${NB_SECTEURS} sectors open on ${dateEN}. Sector exclusivity applies from the ${cap(PALIER_EXCLUSIVITE)} tier. A sector switches to “taken” on the day a contract is signed, never before.` };
const lignes = SECTEURS.map((s) => {
  const en = SECTEURS_EN[s.cle];
  return fr ? { ...s, nomAff: s.nom, ex: s.exemples, arg: s.argument, res: s.reserve } : { ...s, nomAff: s.nomEn, ex: en.examples, arg: en.argument, res: en.reserve };
});
---

<div class="vacance">
  <table class="tv">
    <caption class="vh">{T.legende}</caption>
    <thead>
      <tr>
        <th scope="col">{T.secteur}</th>
        <th scope="col">{T.statut}</th>
        {!compact && <th scope="col">{T.pourquoi}</th>}
      </tr>
    </thead>
    <tbody>
      {lignes.map((s) => (
        <tr class={`tv__ligne tv__ligne--${s.statut}`}>
          <th scope="row">
            <span class="tv__nom">{s.nomAff}</span>
            {!compact && <span class="tv__ex">{s.ex}</span>}
          </th>
          <td class="tv__statut">
            <span class="tv__pastille">{s.statut === 'ouvert' ? T.ouvert : T.pris}</span>
            {s.statut === 'pris' && s.depuis && <span class="tv__depuis">{T.depuis} <time datetime={s.depuis}>{s.depuis}</time></span>}
          </td>
          {!compact && (
            <td class="tv__arg">
              <p>{s.arg}</p>
              {s.res && <p class="tv__reserve"><b>{T.reserve}</b> {s.res}</p>}
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
  <p class="petit t-sourd tv__pied">{T.pied}</p>
</div>

<style>
  .vacance{overflow-x:auto}
  .tv{width:100%;border-collapse:collapse;font-size:var(--t-petit)}
  .tv thead th{text-align:left;font-size:var(--t-micro);letter-spacing:.14em;text-transform:uppercase;
    color:var(--fg-dim);font-weight:700;padding:0 var(--e3) var(--e3) 0;border-bottom:2px solid var(--fg)}
  .tv tbody th,.tv tbody td{padding:var(--e4) var(--e3) var(--e4) 0;border-bottom:1px solid var(--trait);vertical-align:top;text-align:left}
  .tv__nom{display:block;font-family:var(--f-titre);font-weight:900;text-transform:uppercase;font-size:var(--t-h4);line-height:1;color:var(--fg)}
  .tv__ex{display:block;margin-top:.4em;color:var(--fg-dim);font-weight:400;line-height:1.45}
  .tv__statut{white-space:nowrap}
  .tv__pastille{display:inline-block;padding:.35em .7em .3em;font-size:var(--t-micro);font-weight:700;
    letter-spacing:.12em;text-transform:uppercase;clip-path:var(--chanfrein);--c:6px}
  .tv__ligne--ouvert .tv__pastille{background:var(--amber);color:#000}
  .tv__ligne--pris .tv__pastille{background:var(--bloc);color:var(--fg-dim)}
  .tv__ligne--pris .tv__nom{color:var(--fg-dim)}
  .tv__depuis{display:block;margin-top:.4em;color:var(--fg-dim)}
  .tv__arg p{margin:0;line-height:1.5;max-width:52ch}
  .tv__reserve{margin-top:.6em!important;color:var(--fg-dim)}
  .tv__reserve b{color:var(--t-rose)}
  .tv__pied{margin-top:var(--e4)}
</style>
