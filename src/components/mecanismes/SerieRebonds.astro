---
/**
 * SerieRebonds.astro — la série des rebonds, dessinée à l'échelle.
 *
 * La règle d'équipement FIBA : un ballon lâché de 1 800 mm (mesuré au bas du
 * ballon) doit rebondir entre 1 200 et 1 400 mm (mesuré au haut du ballon).
 * On dessine la série pour le milieu de la fourchette, 1 300 mm : chaque
 * rebond garde une fraction constante de la hauteur, et la durée entre deux
 * impacts se calcule (t = 2·sqrt(2h/g)). Les hauteurs s'effondrent en
 * géométrique ; les durées aussi, plus doucement — c'est ce que l'œil lit.
 *
 * Inline, ~1 Ko, zéro JavaScript. Les chiffres sont calculés au build depuis
 * la règle, pas recopiés.
 */

export interface Props { rebonds?: number; largeur?: string }
const { rebonds = 8, largeur = '100%' } = Astro.props;

const H0 = 1.8;          /* m, hauteur de lâcher (règle FIBA 2.4) */
const H1 = 1.3;          /* m, rebond retenu : milieu de 1,20–1,40 */
const G = 9.81;
const ratio = H1 / H0;   /* fraction de hauteur conservée à chaque rebond */
const e = Math.sqrt(ratio); /* coefficient de restitution */

/* Hauteurs successives et durées de vol entre impacts. */
const hauteurs = Array.from({ length: rebonds + 1 }, (_, i) => H0 * Math.pow(ratio, i));
const durees = hauteurs.map((h) => 2 * Math.sqrt((2 * h) / G)); /* s, aller-retour */
/* la première chute est une demi-parabole : on l'affiche pour moitié */
durees[0] = durees[0] / 2;

/* Échelle : x = temps, y = hauteur. */
const PX_PAR_S = 120;
const PX_PAR_M = 60;
const total = durees.reduce((a, b) => a + b, 0);
const W = Math.ceil(total * PX_PAR_S) + 40;
const HAUT = Math.ceil(H0 * PX_PAR_M) + 30;
const SOL = HAUT - 16;

/* Les arcs : une parabole par vol, tracée en quadratique. */
let x = 20;
const arcs: string[] = [];
const labels: { x: number; y: number; h: string; t: string }[] = [];
hauteurs.forEach((h, i) => {
  const d = durees[i] * PX_PAR_S;
  const yTop = SOL - h * PX_PAR_M;
  if (i === 0) {
    /* demi-chute depuis 1,80 m */
    arcs.push(`M${x} ${yTop} Q${x + d * 0.5} ${yTop} ${x + d} ${SOL}`);
  } else {
    /* le contrôle d'une quadratique se place à 2x la hauteur pour que le sommet touche yTop */
    const ctrlY = SOL - (SOL - yTop) * 2;
    arcs.push(`M${x} ${SOL} Q${x + d / 2} ${ctrlY} ${x + d} ${SOL}`);
    labels.push({ x: x + d / 2, y: yTop - 4, h: `${(h * 100).toFixed(0)} cm`, t: `${(durees[i] * 1000).toFixed(0)} ms` });
  }
  x += d;
});
const fin = x;
---

<figure class="rebonds" style={`max-width:${largeur}`}>
  <svg viewBox={`0 0 ${W} ${HAUT}`} role="img" aria-labelledby="reb-t reb-d">
    <title id="reb-t">La série des rebonds d’un ballon réglementaire, à l’échelle</title>
    <desc id="reb-d">Lâché de 1,80 m, un ballon FIBA rebondit à environ 1,30 m, puis à chaque rebond conserve la même fraction de sa hauteur ; les durées entre impacts diminuent avec les hauteurs.</desc>
    <line class="sol" x1="20" y1={SOL} x2={fin} y2={SOL} />
    <line class="repere" x1="20" y1={SOL - H0 * PX_PAR_M} x2={fin} y2={SOL - H0 * PX_PAR_M} />
    <text class="cote" x="22" y={SOL - H0 * PX_PAR_M - 4}>1,80 m — lâcher</text>
    <line class="repere repere--min" x1="20" y1={SOL - 1.2 * PX_PAR_M} x2={fin} y2={SOL - 1.2 * PX_PAR_M} />
    <line class="repere repere--min" x1="20" y1={SOL - 1.4 * PX_PAR_M} x2={fin} y2={SOL - 1.4 * PX_PAR_M} />
    <text class="cote" x="22" y={SOL - 1.4 * PX_PAR_M - 4}>1,20 – 1,40 m — rebond exigé</text>
    {arcs.map((d) => <path class="arc" d={d} />)}
    {labels.map((l) => (
      <g class="label">
        <text x={l.x} y={l.y} text-anchor="middle">{l.h}</text>
        <text x={l.x} y={SOL + 12} text-anchor="middle" class="t">{l.t}</text>
      </g>
    ))}
  </svg>
  <figcaption class="micro t-sourd">
    Règle FIBA sur le ballon : lâché de 1,80 m, il doit remonter entre 1,20 et
    1,40 m. Tracé pour 1,30 m — le ballon garde {(ratio * 100).toFixed(0)} % de
    sa hauteur à chaque rebond (coefficient de restitution {e.toFixed(2)}). Les
    hauteurs et les durées sont calculées, pas dessinées à l’œil.
  </figcaption>
</figure>

<style>
  .rebonds{margin:0}
  .rebonds svg{display:block;width:100%;height:auto}
  .rebonds .sol{stroke:var(--steel);stroke-width:1.5}
  .rebonds .repere{stroke:var(--fg-dim);stroke-width:.6;stroke-dasharray:3 3;opacity:.7}
  .rebonds .repere--min{stroke:var(--t-ambre);opacity:.55}
  .rebonds .arc{fill:none;stroke:var(--ball);stroke-width:1.8;stroke-linecap:round}
  .rebonds .cote{font-family:var(--f-corps);font-size:8px;font-weight:700;fill:var(--fg-dim)}
  .rebonds .label text{font-family:var(--f-corps);font-size:7.5px;font-weight:700;fill:var(--t-ambre)}
  .rebonds .label .t{fill:var(--fg-dim);font-weight:400}
  .rebonds figcaption{margin-top:var(--e3);max-width:52ch}
</style>
