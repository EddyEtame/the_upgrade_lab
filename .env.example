# Public site URL. The .invalid TLD is a deliberate guard: if this is unset,
# canonicals point somewhere that can never resolve rather than somewhere wrong.
PUBLIC_SITE_URL=https://theupgradelab.org

# Double lock on indexability. BOTH must be set before a public build.
PUBLIC_SITE_INDEXABLE=false
PUBLIC_RELEASE_VALIDATED=

# Canal de la demande de séance d'essai (/rejoindre/ et /en/rejoindre/).
# Sans endpoint ni e-mail de contact, la page affiche la fiche à recopier — jamais un formulaire mort.
PUBLIC_FORMULAIRE_ENDPOINT=
# Numéro WhatsApp international, chiffres seuls, sans « + » (ex. 2376XXXXXXXX). Vide = pas de bouton.
PUBLIC_WHATSAPP=
